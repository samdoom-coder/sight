# Sight environment configuration
# Copy this file to .env.development and .env.production and fill in values.
# Never commit real secrets (TURN credentials) to the repository.

# --- Signaling server ---
# URL of the WebSocket signaling server the desktop app connects to.
# Must end with /ws (the server only accepts WebSocket upgrades on that path).
# Vite only exposes VITE_* variables to the renderer, so use the VITE_ prefix.
VITE_SIGNALING_URL=ws://localhost:8787/ws
# Server bind host and port.
HOST=0.0.0.0
PORT=8787

# --- WebRTC ---
# STUN servers used for NAT traversal (can be a comma-free single URL per VITE_ key).
# The desktop app reads VITE_STUN_URL / VITE_TURN_URL / VITE_TURN_USERNAME / VITE_TURN_PASSWORD
# from the renderer environment. Multiple ICE servers can also be configured in-app (Settings → Network).
VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN is required when direct peer-to-peer connectivity is blocked by firewalls.
# Deploy a coturn server and fill these in for production. Prefer the server-side
# TURN_URLS/TURN_SECRET ephemeral credentials below: these VITE_* values are
# baked into the renderer bundle and can be extracted.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# --- Session behaviour ---
# How long an idle session lives before it expires (refreshed by signaling activity).
SESSION_TTL_MS=1800000
# Maximum participants per session (host + guests).
MAX_PARTICIPANTS=8

# --- TURN credentials ---
# Optional: issue short-lived coturn REST credentials with the session so the
# desktop bundle does not need a static TURN password. Configure coturn with
# use-auth-secret/static-auth-secret and the same secret here.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=86400

# --- Signaling security ---
# Rate limiting: max messages per window per connection.
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MESSAGES=60
# Maximum inbound message size in bytes.
MAX_MESSAGE_BYTES=65536
# Comma-separated list of allowed origins for the signaling WebSocket.
# Use * for local dev only. Production example: ALLOWED_ORIGINS=app://sight
ALLOWED_ORIGINS=*
# DoS guard: max active sessions created per client IP.
MAX_SESSIONS_PER_IP=10
# Max concurrent WebSocket connections per client IP.
MAX_CONNECTIONS_PER_IP=20
# Trust X-Forwarded-For / X-Real-IP. Enable only behind a reverse proxy you
# control; otherwise clients can spoof their IP and bypass per-IP limits.
TRUST_PROXY=0
# WebSocket heartbeat (drop dead peers) and shutdown drain timeout.
HEARTBEAT_INTERVAL_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
# How long a host can be disconnected from signaling and still resume the same
# session/code. Guests keep their P2P call alive during this window.
HOST_RECONNECT_GRACE_MS=60000