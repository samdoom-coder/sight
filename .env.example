# Sight environment configuration
# Copy this file to .env.development and .env.production and fill in values.
# Never commit real secrets (TURN credentials) to the repository.

# --- Signaling server ---
# URL of the WebSocket signaling server the desktop app connects to.
# Must end with /ws (the server only accepts WebSocket upgrades on that path).
# Vite only exposes VITE_* variables to the renderer, so use the VITE_ prefix.
VITE_SIGNALING_URL=ws://localhost:8787/ws
# Server bind host and port.
HOST=0.0.0.0
PORT=8787

# --- WebRTC ---
# STUN servers used for NAT traversal (can be a comma-free single URL per VITE_ key).
# The desktop app reads VITE_STUN_URL / VITE_TURN_URL / VITE_TURN_USERNAME / VITE_TURN_PASSWORD
# from the renderer environment. Multiple ICE servers can also be configured in-app (Settings → Network).
VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN is required when direct peer-to-peer connectivity is blocked by firewalls.
# Deploy a coturn server and fill these in for production.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# --- Session behaviour ---
# How long a session lives before it expires.
SESSION_TTL_MS=1800000
# Maximum participants per session.
MAX_PARTICIPANTS=8

# --- Signaling security ---
# Rate limiting: max messages per window per connection.
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MESSAGES=60
# Maximum inbound message size in bytes.
MAX_MESSAGE_BYTES=65536
# Comma-separated list of allowed origins for the signaling WebSocket.
# Use * to allow any origin (not recommended for production).
ALLOWED_ORIGINS=*