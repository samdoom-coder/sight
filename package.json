{
  "name": "sight",
  "version": "0.1.0",
  "description": "Sight — instant peer-to-peer screen sharing made ridiculously simple.",
  "author": "Sight Team",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "vite",
    "dev:main": "npm run build:main && npm run build:preload && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:watch": "tsx watch src/main/index.ts",
    "smoke": "tsx scripts/smoke-signaling.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:server && npm run build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/index.cjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --external:ws --outfile=dist/server/index.js",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "server": "tsx server/src/index.ts",
    "server:start": "node dist/server/index.js",
    "server:prod": "npm run build:server && node dist/server/index.js"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "@vitest/ui": "^4.1.11"
  },
  "build": {
    "appId": "app.sight.desktop",
    "productName": "Sight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
