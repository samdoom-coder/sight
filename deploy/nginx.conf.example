# Sight signaling server — production reverse proxy example (nginx)
# Place in /etc/nginx/sites-available/sight and symlink into sites-enabled.
# Terminates TLS and upgrades HTTP → WebSocket so clients use wss://yourdomain/ws

server {
    listen 80;
    server_name signaling.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name signaling.example.com;

    ssl_certificate     /etc/letsencrypt/live/signaling.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/signaling.example.com/privkey.pem;

    # Allow WebSocket upgrade (required for /ws)
    location /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Health check (plain HTTP)
    location /health {
        proxy_pass http://127.0.0.1:8787;
    }
}