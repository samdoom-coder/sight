# Sight signaling server — systemd unit example
# Place in /etc/systemd/system/sight-signaling.service then:
#   systemctl daemon-reload && systemctl enable --now sight-signaling
#
# Clients connect with SIGNALING_URL=wss://yourdomain/ws when run behind nginx.

[Unit]
Description=Sight P2P signaling server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sight
# Uses the production bundle (run `npm run build:server` first).
ExecStart=/usr/bin/node /opt/sight/dist/server/index.js
Restart=always
RestartSec=3
User=sight
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
# NEVER use * in production — set your real app origins.
Environment=ALLOWED_ORIGINS=app://sight
Environment=SESSION_TTL_MS=1800000
Environment=MAX_PARTICIPANTS=8
Environment=MAX_SESSIONS_PER_IP=10

[Install]
WantedBy=multi-user.target